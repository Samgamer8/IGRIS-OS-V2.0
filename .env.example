# IGRIS OS V2.0 - Environment Variables
# Copia este archivo a .env y configura tus credenciales

# OpenAI (GPT-4, GPT-3.5)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq (Ultra-fast inference)
GROQ_API_KEY=your_groq_api_key_here

# Together AI
TOGETHER_API_KEY=your_together_api_key_here

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Budget settings (USD per request)
MAX_BUDGET_PER_REQUEST=0.50
DEFAULT_BUDGET=0.10

# Provider priority (comma-separated, highest first)
PROVIDER_PRIORITY=ollama,deepseek,groq,anthropic,openai